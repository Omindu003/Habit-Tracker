<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="8dp"
    android:gravity="center_vertical">

    <!-- App name - use smaller text -->

    <!-- Widget title - make bold and slightly larger -->
    <TextView
        android:id="@+id/tvWidgetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/today_habits"
        android:textColor="@color/backgroundColor"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center" />

    <!-- Progress Bar - compact size -->
    <ProgressBar
        android:id="@+id/widgetProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:minHeight="6dp"
        android:maxHeight="8dp"
        android:progressTint="@color/backgroundColor"
        android:progress="75" />

    <!-- Progress text - smaller font, allow wrapping if needed -->
    <TextView
        android:id="@+id/tvWidgetProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/habit_progress_placeholder"
        android:textColor="@color/backgroundColor"
        android:textSize="14sp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>