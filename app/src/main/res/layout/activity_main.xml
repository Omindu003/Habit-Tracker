<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <!-- Header with gradient background -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="@drawable/mood_header_background" />

    <!-- Decorative elements -->
    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@color/colorPrimary"
        android:layout_gravity="top|end"
        android:alpha="0.1"
        android:translationY="-90dp"
        android:translationX="90dp"
        android:rotation="45" />

    <View
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@color/colorSecondary"
        android:layout_gravity="top|start"
        android:alpha="0.1"
        android:translationY="-60dp"
        android:translationX="-60dp"
        android:rotation="30" />

    <!-- Main scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="60dp">

            <!-- User greeting and circle avatar -->
            <androidx.cardview.widget.CardView
                android:id="@+id/profilePreview"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="24dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/colorPrimaryDark"
                    android:padding="12dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:tint="@color/backgroundColor" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/greetingSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toStartOf="@id/profilePreview"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.9"
                    android:text="Welcome back,"
                    android:textColor="@color/backgroundColor"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/headerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/home_greeting"
                    android:textColor="@color/backgroundColor"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"
                    android:text="Let's check your wellness today"
                    android:textColor="@color/backgroundColor"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Health Status Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/healthStatusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/elegant_card_background"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:layout_constraintTop_toBottomOf="@id/greetingSection">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Wellness Status"
                        android:textColor="@color/colorAccent"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.7"
                        android:text="Today, September 29"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/stroke_card_background"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/drop"
                            android:padding="8dp"

                            android:tint="@color/backgroundColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hydration"
                                android:textColor="@color/textColorPrimary"
                                android:textSize="16sp" />

                            <ProgressBar
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:layout_marginTop="4dp"
                                android:progress="65"
                                android:progressTint="@color/colorSecondary" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:text="65%"
                            android:textColor="@color/colorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Main Dashboard Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/healthStatusCard">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <LinearLayout
                        android:id="@+id/dashboardHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/dashboardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Home Page"
                                android:textColor="@color/textColorPrimary"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/dashboardSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:alpha="0.7"
                                android:text="Select an option to track your well-being"
                                android:textColor="@color/textColorPrimary"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Button section: vertical stack -->
                    <LinearLayout
                        android:id="@+id/buttonContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="32dp"
                        app:layout_constraintTop_toBottomOf="@id/dashboardHeader"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <!-- Hydration Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHydration"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginBottom="16dp"
                            android:elevation="6dp"
                            android:text="@string/btn_hydration"
                            android:textColor="@color/backgroundColor"
                            android:textSize="16sp"
                            app:backgroundTint="@color/colorSecondary"
                            app:cornerRadius="28dp"
                            app:icon="@android:drawable/ic_menu_recent_history"
                            app:iconGravity="textStart"
                            app:iconSize="24dp"
                            app:iconTint="@color/backgroundColor" />

                        <!-- Mood Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMood"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginBottom="16dp"
                            android:elevation="6dp"
                            android:text="@string/btn_mood"
                            android:textColor="@color/backgroundColor"
                            android:textSize="16sp"
                            app:backgroundTint="@color/colorSecondary"
                            app:cornerRadius="28dp"
                            app:icon="@android:drawable/ic_menu_myplaces"
                            app:iconGravity="textStart"
                            app:iconSize="24dp"
                            app:iconTint="@color/backgroundColor" />

                        <!-- Habit Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHabit"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginBottom="16dp"
                            android:elevation="6dp"
                            android:text="@string/btn_habit"
                            android:textColor="@color/backgroundColor"
                            android:textSize="16sp"
                            app:backgroundTint="@color/colorSecondary"
                            app:cornerRadius="28dp"
                            app:icon="@android:drawable/ic_menu_agenda"
                            app:iconGravity="textStart"
                            app:iconSize="24dp"
                            app:iconTint="@color/backgroundColor" />

                        <!-- Profile Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnProfile"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:elevation="6dp"
                            android:text="@string/btn_profile"
                            android:textColor="@color/backgroundColor"
                            android:textSize="16sp"
                            app:backgroundTint="@color/colorSecondary"
                            app:cornerRadius="28dp"
                            app:icon="@android:drawable/ic_menu_my_calendar"
                            app:iconGravity="textStart"
                            app:iconSize="24dp"
                            app:iconTint="@color/backgroundColor" />
                    </LinearLayout>

                    <!-- Quote of the day -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        app:cardBackgroundColor="#F5F9FF"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/buttonContainer">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Quote of the Day"
                                android:textColor="@color/colorAccent"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="end"
                                android:text="— Virgil"
                                android:textColor="@color/colorPrimary"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>